# 复制为 backend/.env 后填写真实值
APP_ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./data/app.db

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

# Milvus 3.0 —— URI 必须是 https:// 开头的地址，Token 单独放
MILVUS_URI=https://in03-xxxx.serverless.<region>.cloud.zilliz.com
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=novel_chunks_d1024
MILVUS_DIM=1024
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_TIMEOUT=30
MILVUS_CONSISTENCY=Strong

# 本地 Embedding。provider: auto | onnx | tei | hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MS_REPO=Xenova/bge-large-zh-v1.5
EMBEDDING_ONNX_FILE=onnx/model_quantized.onnx
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
EMBEDDING_THREADS=8
EMBEDDING_MAX_TOKENS=512
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_CACHE_DIR=./data/models

# LLM（OpenAI 兼容）
LLM_BASE_URL=https://api.360.cn/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5
LLM_MODEL_FAST=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=4
LLM_JSON_MODE=auto

CHUNK_PARENT_SIZE=1400
CHUNK_CHILD_SIZE=400
CHUNK_OVERLAP=60
RETRIEVE_TOP_K=20
CONTEXT_PARENTS=8
ENABLE_CHAPTER_SUMMARY=false
