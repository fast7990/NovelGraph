# 复制为 backend/.env 后填写真实值
APP_ENV=dev
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# PostgreSQL + pgvector：元数据、切片、向量、词法索引全在这一个库里
DATABASE_URL=postgresql+asyncpg://postgres:__PGPASSWORD__@127.0.0.1:5432/novel_rag

# 向量库：pgvector（默认）| numpy（离线兜底）
VECTOR_BACKEND=pgvector
PGVECTOR_TABLE=chunk_vectors
PGVECTOR_INDEX=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100
PGVECTOR_ITERATIVE_SCAN=relaxed_order

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

# Milvus 3.0 —— URI 必须是 https:// 开头的地址，Token 单独放
MILVUS_URI=https://in03-xxxx.serverless.<region>.cloud.zilliz.com
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=novel_chunks_d1024
MILVUS_DIM=1024
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_TIMEOUT=30
MILVUS_CONSISTENCY=Strong

# 本地 Embedding。provider: auto | onnx | tei | hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MS_REPO=Xenova/bge-large-zh-v1.5
EMBEDDING_ONNX_FILE=onnx/model_quantized.onnx
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
EMBEDDING_THREADS=8
EMBEDDING_MAX_TOKENS=512
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_CACHE_DIR=./data/models

# LLM（OpenAI 兼容）
LLM_BASE_URL=https://api.360.cn/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5
LLM_MODEL_FAST=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=4
LLM_JSON_MODE=auto

CHUNK_PARENT_SIZE=1400
CHUNK_CHILD_SIZE=400
CHUNK_OVERLAP=60
RETRIEVE_TOP_K=20
CONTEXT_PARENTS=8
ENABLE_CHAPTER_SUMMARY=false

# ---------- 混合检索（P1-M6）----------
# 词法通道：SQLite FTS5 + 自建 bigram（中文两字词用 trigram 会漏，见 services/retrieval/lexical.py）
LEXICAL_ENABLED=true
# 两路召回的候选数，供 RRF 融合；调大只增加延迟，不提升准确率
RETRIEVE_DENSE_TOP_K=50
RETRIEVE_SPARSE_TOP_K=50
# RRF 的 k，60 为原论文默认；越大越依赖多路共识
RRF_K=60

# ---------- 精排（cross-encoder）----------
# 模型缺失或加载失败时自动降级为"只用 RRF 排序"，问答不中断
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MS_REPO=Xenova/bge-reranker-base
RERANK_ONNX_FILE=onnx/model_int8.onnx
RERANK_INPUT_K=50
RERANK_TOP_N=24
RERANK_MAX_LENGTH=512
RERANK_THREADS=8
